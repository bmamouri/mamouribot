{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // archive/ is deliberately excluded: those are spent one-off scripts, kept for
  // the record, and never ran under strict mode.
  "include": ["src/**/*.ts", "tools/**/*.ts"]
}
